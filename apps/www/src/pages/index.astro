---
import MetaPage from "@/components/MetaPage.astro"
import ProjectCard from "@/components/ProjectCard.astro"
import Layout from "@/layouts/Layout.astro"
import { getFeaturedProjects } from "@/lib/content"
import { Image } from "astro:assets"
import logo from "../../public/static/logo.png"

const projects = await getFeaturedProjects()
// const publications = await getFeaturedPublications()
---

<Layout>
  <MetaPage slot="head" />
  <dictionary-entry>
    <Image src={logo} alt={'Fabian Piper'} width={512} height={512} />
    <h1>Hi 👋</h1>
    <p>
      I'm a Software Engineer based in Berlin, Germany. Below, you can find a
      selection of my <a href="projects">projects</a>,{" "}
      <a href="projects">contributions</a>,{" "}and{" "}
      <a href="publications">publications</a>. I'm always open to new
      connections and interesting discussions. Please feel free to reach out.
      I'd love to hear from you!
    </p>
    <hr>
  </dictionary-entry>
  <section>
    <h2>Projects</h2>

    {projects.length > 0 ? (
    <ul>
      {projects.map((project) => <ProjectCard entry={project} />)}
    </ul>
  ) : (
    <p>No projects found</p>
  )}
  </section>
</Layout>

<style>
  h1,
  h2 {
    font-size: var(--step-2);
    line-height: calc(var(--leading-offset) + 1em);
    font-weight: var(--font-weight-medium);
    color: var(--foreground);
    margin-block-end: var(--space-2xs);
  }

  dictionary-entry {
    display: block;
    font-size: var(--step-0);
    color: var(--muted-foreground);

    @media (width >= 64rem) {
      margin-block-start: -0.2em;
    }

    :global(img) {
      margin-block-end: var(--space-2xs);
      flex-shrink: 0;
      border-radius: 0rem;
      inline-size: 9rem;
      block-size: auto;
    }

    ol {
      margin-block-start: var(--space-xs);
      list-style: none;

      li {
        padding-inline-start: 1em;
        text-indent: -1em;

        &::before {
          content: counter(list-item);
          display: inline-block;
          inline-size: 1em;
          text-indent: 0;
          font-weight: var(--font-weight-medium);
        }

        + li {
          margin-block-start: var(--space-3xs);
        }
      }
    }

    hr {
      margin-block: var(--space-m);
      border-block-start: 2px solid var(--border);
    }

    prose-content {
      margin-block-start: var(--space-xs);
    }
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }
</style>
