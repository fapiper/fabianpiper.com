---
import MetaPage from "@/components/MetaPage.astro"
import ProjectCard from "@/components/ProjectCard.astro"
import PublicationCard from "@/components/PublicationCard.astro"
import Layout from "@/layouts/Layout.astro"
import { getFeaturedProjects, getFeaturedPublications } from "@/lib/content"
import { Image } from "astro:assets"
import logo from "../../public/static/logo.png"

const projects = await getFeaturedProjects()
const publications = await getFeaturedPublications()
---

<Layout>
  <MetaPage slot="head" />
  <dictionary-entry>
    <Image src={logo} alt={'Fabian Piper'} width={512} height={512} />
    <h1>Hi 👋</h1>
    <p>
      I'm a Software Engineer based in Berlin, Germany. Below, you can find a
      selection of my <a href="projects">projects</a>,{" "}
      <a href="projects">contributions</a>,{" "}and{" "}
      <a href="publications">publications</a>. I'm always open to new
      connections and interesting discussions. Please feel free to reach out.
      I'd love to hear from you!
    </p>
    <hr>
  </dictionary-entry>
  <section>
    <h2>Projects</h2>

    {projects.length > 0 ? (
    <ul>
      {projects.map((project) => <ProjectCard entry={project} />)}
    </ul>
  ) : (
    <p>No projects found</p>
  )}

    <section-footer>
      <button>
        <a href="projects/">View more projects</a>
      </button>
    </section-footer>
  </section>

  <section>
    <h2>Publications</h2>

    {publications.length > 0 ? (
      <ul>
        {publications.map((publication) => <PublicationCard entry={publication} />)}
      </ul>
    ) : (
      <p>No publications found</p>
    )}

    <section-footer>
      <button>
        <a href="publications/">View more publications</a>
      </button>
    </section-footer>
  </section>
</Layout>

<style>
  h1,
  h2 {
    font-size: var(--step-2);
    line-height: calc(var(--leading-offset) + 1em);
    font-weight: var(--font-weight-medium);
    color: var(--foreground);
    margin-block: var(--space-xs);
  }

  dictionary-entry {
    display: block;
    font-size: var(--step-0);
    color: var(--muted-foreground);

    @media (width >= 64rem) {
      margin-block-start: -0.2em;
    }

    :global(img) {
      margin-block-end: var(--space-2xs);
      flex-shrink: 0;
      border-radius: 0rem;
      inline-size: 9rem;
      block-size: auto;
    }

    ol {
      margin-block-start: var(--space-xs);
      list-style: none;

      li {
        padding-inline-start: 1em;
        text-indent: -1em;

        &::before {
          content: counter(list-item);
          display: inline-block;
          inline-size: 1em;
          text-indent: 0;
          font-weight: var(--font-weight-medium);
        }

        + li {
          margin-block-start: var(--space-3xs);
        }
      }
    }

    hr {
      margin-block: var(--space-m);
      border-block-start: 2px solid var(--border);
    }

    prose-content {
      margin-block-start: var(--space-xs);
    }
  }

  section {
    display: block;
    margin-block: var(--space-l);

    section-footer {
      display: flex;
      justify-content: flex-start;
      margin-block-start: var(--space-s);

      @media (width < 40rem) {
        justify-content: center;
      }

      button {
        padding: var(--space-xs) var(--space-s);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        background-color: var(--background);
        color: var(--foreground);
        font-size: var(--step--2);
        font-weight: var(--font-weight-medium);
        cursor: pointer;

        @media (width < 40rem) {
          width: 100%;
        }

        a {
          text-decoration: none;
          color: inherit;
        }

        &:hover {
          background-color: var(--muted-background);
          border-color: color-mix(
            in oklab,
            var(--muted-foreground) 50%,
            transparent
          );
        }
      }
    }
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }
</style>
