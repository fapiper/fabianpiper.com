---
import ExternalIcon from "@/assets/icons/external.svg"
import { formatYear } from "@/lib/utils"
import { Image } from "astro:assets"
import type { CollectionEntry } from "astro:content"

type Props = { entry: CollectionEntry<"publications"> }

const { entry } = Astro.props
const {
  title,
  authors,
  published,
  publishedIn,
  pdfUrl,
  htmlUrl,
  doi,
  paperType,
  date,
  image,
} = entry.data

const MAIN_AUTHOR = "Fabian Piper"

const abbreviate = (name: string) => {
  const parts = name.trim().split(" ")
  if (parts.length === 1) return name
  const initials = parts
    .slice(0, -1)
    .map((p) => p[0] + ".")
    .join(" ")
  return `${initials} ${parts[parts.length - 1]}`
}

const pillLinks = [
  pdfUrl && { label: "PDF", href: pdfUrl },
  htmlUrl && { label: "HTML", href: htmlUrl },
  doi && { label: "DOI", href: `https://doi.org/${doi}` },
].filter(Boolean) as { label: string; href: string }[]

const primaryMetaLink = doi
  ? { href: `https://doi.org/${doi}`, label: paperType }
  : pdfUrl
    ? { href: pdfUrl, label: paperType }
    : htmlUrl
      ? { href: htmlUrl, label: paperType }
      : null

const primaryHref = doi ? `https://doi.org/${doi}` : (pdfUrl ?? htmlUrl ?? null)

const imageProps = image ? { src: image, alt: title } : null
---

<li>
  {imageProps && (
    <a
      href={primaryHref}
      target="_blank"
      rel="noopener noreferrer"
      tabindex="-1"
      aria-hidden="true"
    >
      <Image {...imageProps} width={640} height={336} />
    </a>
  )}
  <entry-info>
    <h3>{title}</h3>
    <entry-meta>
      {date && (
        <publication-date>
          <time datetime={date.toISOString()}>{formatYear(date)}</time>
        </publication-date>
      )}
      {primaryMetaLink && (
        <a class="primary-link" href={primaryMetaLink.href} target="_blank" rel="noopener noreferrer">
          <ExternalIcon aria-hidden="true" />
          {primaryMetaLink.label}
        </a>
      )}
    </entry-meta>
    <publication-authors>
      By{" "}
      {authors.map((author, i) => (
        <span>
          <span class:list={[author === MAIN_AUTHOR && "main-author"]}>
            {author === MAIN_AUTHOR ? author : abbreviate(author)}
          </span>{i < authors.length - 1 ? ",\u00A0" : ""}
        </span>
      ))}
    </publication-authors>
    {publishedIn && (
      <p class="publication-venue">
        {published ? "In proceedings of" : "To appear in"}{" "}
        <a href={publishedIn.url} target="_blank" rel="noopener noreferrer">{publishedIn.name}</a>
      </p>
    )}
    {pillLinks.length > 0 && (
      <project-links>
        {pillLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        ))}
      </project-links>
    )}
  </entry-info>
</li>

<style>
  li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-s);

    > a {
      flex-shrink: 0;
      inline-size: 14rem;

      :global(img) {
        inline-size: 100%;
        block-size: auto;
      }
    }

    entry-info {
      display: flex;
      flex-direction: column;

      h3 {
        font-size: var(--step-1);
        line-height: calc(var(--leading-offset) + 1em);
        font-weight: var(--font-weight-medium);
      }

      entry-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-3xs);
        margin-block-end: var(--space-3xs);
        font-size: var(--step--1);
        color: var(--muted-foreground);

        publication-date {
          display: flex;
          align-items: center;
          gap: var(--space-3xs);
        }

        publication-date:has(~ a.primary-link)::after {
          content: "·";
          color: var(--muted-foreground);
        }
      }

      publication-authors,
      p.publication-venue {
        font-size: var(--step--1);
        color: var(--muted-foreground);
      }

      publication-authors .main-author {
        color: var(--foreground);
        font-weight: var(--font-weight-medium);
      }

      a.primary-link,
      project-links a {
        display: flex;
        align-items: center;
        gap: var(--space-3xs);
        text-decoration: none;

        svg {
          inline-size: 1em;
          block-size: 1em;
        }
      }

      a.primary-link {
        color: color-mix(in oklab, var(--muted-foreground) 50%, transparent);

        &:hover {
          color: var(--muted-foreground);
        }
      }

      project-links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3xs);
        margin-block-start: var(--space-2xs);
        font-size: var(--step--1);

        a {
          padding-inline: var(--space-2xs);
          color: var(--muted-foreground);
          background-color: color-mix(in oklab, var(--muted) 50%, transparent);
          border-radius: var(--radius-full);

          &:hover {
            background-color: var(--muted);
          }
        }
      }
    }

    @media (width < 40rem) {
      flex-direction: column;

      > a {
        inline-size: 100%;
        max-inline-size: 32rem;
      }
    }
  }
</style>
