---
import ExternalIcon from "@/assets/icons/external.svg"
import { formatYear } from "@/lib/utils"
import { Image } from "astro:assets"
import type { CollectionEntry } from "astro:content"

type Props = { entry: CollectionEntry<"projects"> }

const { entry } = Astro.props
const { name, description, links, tags, image, date } = entry.data

const primaryLink = links && links.length > 0 ? links[0].href : null

let imageProps = null

if (entry.data.image) {
  imageProps = {
    src: entry.data.image,
    alt: entry.data.name,
  }
}
---

<li>
  {imageProps && (
      <a
        href={primaryLink}
        target="_blank"
        rel="noopener noreferrer"
        tabindex="-1"
        aria-hidden="true"
      >
        <Image {...imageProps} width={640} height={336} />
      </a>
    )}
  <entry-info>
    <a href={primaryLink} target="_blank" rel="noopener noreferrer">{name}</a>
    <entry-meta>
      {date && (
          <project-dates>
            <time datetime={date.toISOString()}>
              {formatYear(date)}
            </time>
          </project-dates>
        )}
      {primaryLink && (
          <a class="primary-link" href={primaryLink} target="_blank" rel="noopener noreferrer">
            <ExternalIcon aria-hidden="true" />
            {new URL(primaryLink).hostname}
          </a>
        )}
    </entry-meta>
    <p>{description}</p>
    {links && links.length > 0 && (
      <project-links>
          {links.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}</a>
          ))}
        </project-links>
      )}
  </entry-info>
</li>

<style>
  li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-s);

    > a {
      flex-shrink: 0;
      inline-size: 14rem;

      :global(img) {
        inline-size: 100%;
        block-size: auto;
      }
    }

    entry-info {
      display: flex;
      flex-direction: column;

      > a {
        font-size: var(--step-1);
        line-height: calc(var(--leading-offset) + 1em);
        font-weight: var(--font-weight-medium);
      }

      entry-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-3xs);
        margin-block-end: var(--space-3xs);
        font-size: var(--step--1);
        color: var(--muted-foreground);

        project-dates {
          display: flex;
          align-items: center;
          gap: var(--space-3xs);
        }

        project-dates:has(~ a.primary-link)::after {
          content: "·";
          color: var(--muted-foreground);
        }
      }

      p {
        color: var(--muted-foreground);
      }

      a.primary-link,
      project-links a {
        display: flex;
        align-items: center;
        gap: var(--space-3xs);
        text-decoration: none;

        svg {
          inline-size: 1em;
          block-size: 1em;
        }
      }

      a.primary-link {
        color: color-mix(in oklab, var(--muted-foreground) 50%, transparent);

        &:hover {
          color: var(--muted-foreground);
        }
      }

      project-links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3xs);
        margin-block-start: var(--space-2xs);
        font-size: var(--step--1);

        a {
          padding-inline: var(--space-2xs);
          color: var(--muted-foreground);
          background-color: color-mix(in oklab, var(--muted) 50%, transparent);
          border-radius: var(--radius-full);

          &:hover {
            background-color: var(--muted);
          }
        }
      }
    }

    @media (width < 40rem) {
      flex-direction: column;

      > a {
        inline-size: 100%;
        max-inline-size: 32rem;
      }
    }
  }
</style>
